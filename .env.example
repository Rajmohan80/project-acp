# ============================================================
# AbhavTech Agentic Control Plane — environment placeholders
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# OAuth issuer
OAUTH_ISSUER_URL=http://localhost:9000
OAUTH_SECRET_KEY=OAUTH_SECRET_KEY=dev-secret-replace-in-production-32ch
OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# MCP server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100
MCP_AUTHORIZE_AUTOMATIC_SERVER_DATA_UPDATES=false

# Audit trail
AUDIT_LOG_PATH=audit.log

# Logging
LOG_LEVEL=INFO

# Domain secrets (populated in later phases)
# QDRANT_URL=
# QDRANT_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=