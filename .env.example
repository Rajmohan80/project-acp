# ============================================================
# AbhavTech Agentic Control Plane — environment placeholders
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# OAuth issuer
OAUTH_ISSUER_URL=http://localhost:9000
OAUTH_SECRET_KEY=your-32-char-secret-key-replace-in-production
OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# MCP server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100
MCP_AUTHORIZE_AUTOMATIC_SERVER_DATA_UPDATES=false

# Audit trail
AUDIT_LOG_PATH=audit.log

# Logging
LOG_LEVEL=INFO

# Domain secrets (populated in Phase 1+)
# Get your Qdrant URL and API key from https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=wxcc_slm_corpus

# BGE-M3 model cache directory (avoids re-downloading 2.27GB model)
HF_HOME=D:\hf_cache

# LLM providers — set the one(s) you use
# Get your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Anthropic (optional — not used in current build)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
